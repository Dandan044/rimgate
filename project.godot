; Rimgate combat demo. Engine and export templates: Godot 4.7.2.
config_version=5

[application]
config/name="Rimgate · 防线"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.065, 0.08, 0.08, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
